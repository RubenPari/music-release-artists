# Copy to /etc/music-release-artists/deploy.env (mode 0640).
# This file controls image selection and public routing; it contains no app secrets.
PUBLIC_DOMAIN=music.example.com
ACME_EMAIL=admin@example.com
IMAGE_REGISTRY=ghcr.io/your-github-user/music-release-artists
IMAGE_TAG=sha-replace-me
# Optional; set both only when the GHCR images are private.
GHCR_USERNAME=
GHCR_TOKEN_FILE=
APP_ENV_FILE=/etc/music-release-artists/app.env
DATABASE_CA_FILE=/etc/music-release-artists/ca-certificate.crt
DATABASE_POOL_MAX=8
