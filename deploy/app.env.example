# Reference env values for App Platform (set as GitHub Actions secrets/vars
# and/or in .do/app.yaml). Do not commit real secrets.
#
# Runtime (service backend) uses the attached Managed DB user mra_app via
# ${db.DATABASE_URL}. Migrations use MIGRATION_DATABASE_URL (mra_migrator).
#
# Prefer sslmode=require on App Platform (no CA file mount).

NODE_ENV=production
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
APP_BASE_URL=https://music.example.com/api
FRONTEND_ORIGIN=https://music.example.com
EMAIL_ENABLED=false
# Required only when EMAIL_ENABLED=true.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=notifications@example.com
BREVO_SENDER_NAME=Uscite
RELEASE_WINDOW_DAYS=90
DATABASE_POOL_MAX=8
