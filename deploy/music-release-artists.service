[Unit]
Description=Music Release Artists production stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/music-release-artists
ExecStart=/usr/bin/docker compose --env-file /etc/music-release-artists/deploy.env -f docker-compose.prod.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file /etc/music-release-artists/deploy.env -f docker-compose.prod.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
