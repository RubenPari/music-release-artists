# Spotify Developer App — https://developer.spotify.com/dashboard
# Redirect URI: http://127.0.0.1:4200/api/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Secrets (change in any shared/prod environment)
SESSION_SECRET=change-me-session-secret-32chars
TOKEN_ENCRYPTION_KEY=change-me-token-encryption-key
POSTGRES_PASSWORD=music

# URLs (defaults work with docker compose)
APP_BASE_URL=http://127.0.0.1:4200/api
FRONTEND_ORIGIN=http://127.0.0.1:4200

# Email notifications. Brevo values are required only when enabled.
EMAIL_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=notifications@example.com
BREVO_SENDER_NAME=Uscite

RELEASE_WINDOW_DAYS=90
