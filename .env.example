# Spotify Developer App — https://developer.spotify.com/dashboard
# Redirect URI: http://localhost:4200/api/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Secrets (change in any shared/prod environment)
SESSION_SECRET=change-me-session-secret-32chars
TOKEN_ENCRYPTION_KEY=change-me-token-encryption-key
POSTGRES_PASSWORD=music

# URLs (defaults work with docker compose)
APP_BASE_URL=http://localhost:4200/api
FRONTEND_ORIGIN=http://localhost:4200

SMTP_FROM=noreply@music-release.local
RELEASE_WINDOW_DAYS=90
